meta {
  name: Get manga collection by id
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/manga-collections/{{collectionId}}
  body: none
  auth: none
}

headers {
  Accept: {{contentType}}
}

tests {
  test("returns 200 with matching id and type MANGA_COLLECTION", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().id).to.equal(Number(vars.get("collectionId")));
    expect(res.getBody().type).to.equal("MANGA_COLLECTION");
  });
}

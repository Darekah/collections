@baseUrl = http://localhost:8080
@contentType = application/json

###
# =============================================================================
#  LEGACY: /api/items  (generic flat item CRUD — kept for reference)
# =============================================================================
###

### Create item — expects 201
# @name createItem
POST {{baseUrl}}/api/items
Content-Type: {{contentType}}

{
  "title": "El nombre del viento",
  "description": "Primera parte de Crónica del Asesino de Reyes",
  "type": "BOOK",
  "year": 2007
}

> {%
    client.global.set("itemId", response.body.id);
    client.test("Create returns 201 and Location header", function() {
        client.assert(response.status === 201, "Expected 201 but got " + response.status);
        client.assert(response.headers.valueOf("Location") !== null, "Missing Location header");
    });
%}

### List all items — expects 200
GET {{baseUrl}}/api/items
Accept: {{contentType}}

> {%
    client.test("List returns 200 and array", function() {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(Array.isArray(response.body), "Body is not an array");
    });
%}

### Get created item by id — expects 200
GET {{baseUrl}}/api/items/{{itemId}}
Accept: {{contentType}}

> {%
    client.test("Get returns 200 and matching id", function() {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(response.body.id === client.global.get("itemId"), "ID mismatch");
    });
%}

### Update created item — expects 200
PUT {{baseUrl}}/api/items/{{itemId}}
Content-Type: {{contentType}}

{
  "title": "El nombre del viento (edición revisada)",
  "description": "Primera parte de Crónica del Asesino de Reyes",
  "type": "BOOK",
  "year": 2007
}

> {%
    client.test("Update returns 200 and new title", function() {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(response.body.title.includes("revisada"), "Title not updated");
    });
%}

### Validation error (blank title) — expects 400
POST {{baseUrl}}/api/items
Content-Type: {{contentType}}

{
  "title": "",
  "type": "BOOK"
}

> {%
    client.test("Validation returns 400 with details", function() {
        client.assert(response.status === 400, "Expected 400 but got " + response.status);
        client.assert(response.body.details.length > 0, "Missing validation details");
    });
%}

### Not found (unused id) — expects 404
GET {{baseUrl}}/api/items/999999
Accept: {{contentType}}

> {%
    client.test("Unknown id returns 404", function() {
        client.assert(response.status === 404, "Expected 404 but got " + response.status);
    });
%}

### Delete created item — expects 204
DELETE {{baseUrl}}/api/items/{{itemId}}

> {%
    client.test("Delete returns 204", function() {
        client.assert(response.status === 204, "Expected 204 but got " + response.status);
    });
%}

### Get after delete — expects 404
GET {{baseUrl}}/api/items/{{itemId}}
Accept: {{contentType}}

> {%
    client.test("Deleted item returns 404", function() {
        client.assert(response.status === 404, "Expected 404 but got " + response.status);
    });
%}

###
# =============================================================================
#  /api/mangas  — Manga CRUD & Upsert
# =============================================================================
###

### Upsert single manga (no id = INSERT) — expects 200
# @name upsertSingleManga
POST {{baseUrl}}/api/mangas
Content-Type: {{contentType}}

{
  "title": "Berserk Vol. 1",
  "originalTitle": "ベルセルク 1",
  "description": "Dark fantasy story of Guts, a lone mercenary.",
  "year": 1989,
  "coverUrl": "https://example.com/berserk-1.jpg",
  "author": "Kentaro Miura",
  "publisher": "Hakusensha",
  "volumeNumber": 1,
  "isbn": "9784592135746",
  "pageCount": 224,
  "format": "TANKOBON"
}

> {%
    client.global.set("mangaId", response.body.items[0].id);
    client.test("Upsert single manga: 200 + created=1", function() {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(response.body.createdCount === 1, "Expected createdCount=1");
        client.assert(response.body.updatedCount === 0, "Expected updatedCount=0");
        client.assert(response.body.items[0].type === "MANGA", "Expected type MANGA");
    });
%}

### Upsert batch (multiple mangas, no id = all INSERT) — expects 200
POST {{baseUrl}}/api/mangas
Content-Type: {{contentType}}

[
  {
    "title": "Chainsaw Man Vol. 1",
    "originalTitle": "チェンソーマン 1",
    "year": 2019,
    "author": "Tatsuki Fujimoto",
    "publisher": "Norma Editorial",
    "volumeNumber": 1,
    "isbn": "9788467941746",
    "pageCount": 192,
    "format": "TANKOBON"
  },
  {
    "title": "Chainsaw Man Vol. 2",
    "originalTitle": "チェンソーマン 2",
    "year": 2019,
    "author": "Tatsuki Fujimoto",
    "publisher": "Norma Editorial",
    "volumeNumber": 2,
    "pageCount": 192,
    "format": "TANKOBON"
  }
]

> {%
    client.test("Batch upsert: 200 + createdCount=2", function() {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(response.body.totalProcessed === 2, "Expected 2 processed");
        client.assert(response.body.createdCount === 2, "Expected createdCount=2");
    });
%}

### Upsert existing manga by id (UPDATE) — expects 200
POST {{baseUrl}}/api/mangas
Content-Type: {{contentType}}

{
  "id": {{mangaId}},
  "title": "Berserk Vol. 1 (Edición deluxe)",
  "originalTitle": "ベルセルク 1",
  "year": 1989,
  "author": "Kentaro Miura",
  "publisher": "Planeta Cómic",
  "volumeNumber": 1,
  "isbn": "9784592135746",
  "pageCount": 248,
  "format": "KANZENBAN"
}

> {%
    client.test("Update existing manga: 200 + updatedCount=1", function() {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(response.body.updatedCount === 1, "Expected updatedCount=1");
        client.assert(response.body.createdCount === 0, "Expected createdCount=0");
        client.assert(response.body.items[0].format === "KANZENBAN", "Format not updated");
    });
%}

### List all mangas — expects 200
GET {{baseUrl}}/api/mangas
Accept: {{contentType}}

> {%
    client.test("List mangas: 200 and non-empty array", function() {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(Array.isArray(response.body), "Body is not an array");
    });
%}

### Get manga by id — expects 200
GET {{baseUrl}}/api/mangas/{{mangaId}}
Accept: {{contentType}}

> {%
    client.test("Get manga by id: 200", function() {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(response.body.id === client.global.get("mangaId"), "ID mismatch");
        client.assert(response.body.type === "MANGA", "Expected type MANGA");
    });
%}

### Upsert with non-existent id — expects 404
POST {{baseUrl}}/api/mangas
Content-Type: {{contentType}}

{
  "id": 999999,
  "title": "Ghost Manga",
  "author": "Unknown"
}

> {%
    client.test("Non-existent id returns 404", function() {
        client.assert(response.status === 404, "Expected 404 but got " + response.status);
    });
%}

### Validation error (missing required fields) — expects 400
POST {{baseUrl}}/api/mangas
Content-Type: {{contentType}}

{
  "title": "",
  "author": ""
}

> {%
    client.test("Validation returns 400", function() {
        client.assert(response.status === 400, "Expected 400 but got " + response.status);
        client.assert(response.body.details.length > 0, "Missing validation details");
    });
%}

### Delete manga — expects 204
DELETE {{baseUrl}}/api/mangas/{{mangaId}}

> {%
    client.test("Delete manga: 204", function() {
        client.assert(response.status === 204, "Expected 204 but got " + response.status);
    });
%}